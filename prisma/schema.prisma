generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  username          String              @unique
  email             String?             @unique
  phone             String?             @unique
  passwordHash      String
  name              String
  role              UserRole
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  wali              WaliMurid?
  notifications     Notification[]
  transaksiKasir    TransaksiKoperasi[]
  verifiedPayments  Pembayaran[]        @relation("VerifiedPayments")
  approvedPayments  Pembayaran[]        @relation("ApprovedPayments")
  auditLogs         AuditLog[]
}

model WaliMurid {
  id      String   @id @default(uuid()) @db.Uuid
  user    User     @relation(fields: [userId], references: [id])
  userId  String   @unique @db.Uuid
  alamat  String?
  siswa   Siswa[]
}

model Kelas {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique
  siswa   Siswa[]
}

model TahunAjaran {
  id       String    @id @default(uuid()) @db.Uuid
  year     String    @unique
  isActive Boolean   @default(false)
  tagihan  Tagihan[]
}

model Siswa {
  id            String              @id @default(uuid()) @db.Uuid
  nisn          String              @unique
  name          String
  status        SiswaStatus         @default(AKTIF)
  kelas         Kelas               @relation(fields: [kelasId], references: [id])
  kelasId       String              @db.Uuid
  wali          WaliMurid           @relation(fields: [waliId], references: [id])
  waliId        String              @db.Uuid
  potonganTetap Decimal             @default("0.0")
  tagihan       Tagihan[]

  // Feature E-Wallet Uang Saku & Koperasi
  saldoSaku     Decimal             @default("0.0")
  limitHarian   Decimal             @default("20000.0")
  topupSaku     TopupSaku[]
  transaksiMart TransaksiKoperasi[]
}

model JenisTagihan {
  id      String       @id @default(uuid()) @db.Uuid
  name    String       @unique
  type    TagihanType
  nominal Decimal
  tagihan Tagihan[]
}

model Tagihan {
  id             String         @id @default(uuid()) @db.Uuid
  siswa          Siswa          @relation(fields: [siswaId], references: [id])
  siswaId        String         @db.Uuid
  jenisTagihan   JenisTagihan   @relation(fields: [jenisTagihanId], references: [id])
  jenisTagihanId String         @db.Uuid
  tahunAjaran    TahunAjaran    @relation(fields: [tahunAjaranId], references: [id])
  tahunAjaranId  String         @db.Uuid
  nominalAwal    Decimal
  potongan       Decimal        @default("0.0")
  nominalAkhir   Decimal
  nominalTerbayar Decimal       @default("0.0")
  dueDate        DateTime
  period         String
  status         TagihanStatus  @default(BELUM_BAYAR)
  catatanTagihan String?
  pembayaran     Pembayaran[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([siswaId, status])
  @@index([jenisTagihanId, tahunAjaranId, period])
}

model Pembayaran {
  id               String    @id @default(uuid()) @db.Uuid
  tagihan          Tagihan   @relation(fields: [tagihanId], references: [id])
  tagihanId        String    @db.Uuid
  nominalDisetor   Decimal   @default("0.0")
  buktiUrl         String?
  catatanWali      String?
  catatanAdmin     String?
  catatanBendahara String?
  verifiedAt       DateTime?
  verifiedByUserId String?   @db.Uuid
  verifiedByUser   User?     @relation("VerifiedPayments", fields: [verifiedByUserId], references: [id])
  approvedAt       DateTime?
  approvedByUserId String?   @db.Uuid
  approvedByUser   User?     @relation("ApprovedPayments", fields: [approvedByUserId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tagihanId])
  @@index([approvedAt])
}

model TopupSaku {
  id           String      @id @default(uuid()) @db.Uuid
  siswa        Siswa       @relation(fields: [siswaId], references: [id])
  siswaId      String      @db.Uuid
  nominal      Decimal
  buktiUrl     String?
  status       TopupStatus @default(MENUNGGU_VERIFIKASI)
  catatanWali  String?
  catatanAdmin String?
  verifiedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([siswaId, status])
}

model TransaksiKoperasi {
  id            String   @id @default(uuid()) @db.Uuid
  siswa         Siswa    @relation(fields: [siswaId], references: [id])
  siswaId       String   @db.Uuid
  kasir         User     @relation(fields: [kasirId], references: [id])
  kasirId       String   @db.Uuid
  totalBelanja  Decimal
  catatanBarang String?
  createdAt     DateTime @default(now())

  @@index([siswaId, createdAt])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model InstitutionSettings {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String   @db.Uuid
  details    String?
  createdAt  DateTime @default(now())
}

enum UserRole {
  ADMIN
  WALIMURID
  BENDAHARA
  KOPERASI
}

enum SiswaStatus {
  AKTIF
  ALUMNI
  KELUAR
  CUTI
}

enum TagihanType {
  BULANAN
  TAHUNAN
  BEBAS
}

enum TagihanStatus {
  BELUM_BAYAR
  DIBAYAR_SEBAGIAN
  MENUNGGU_VERIFIKASI_ADMIN
  MENUNGGU_APPROVAL_BENDAHARA
  LUNAS
  DITOLAK_ADMIN
  DITOLAK_BENDAHARA
}

enum TopupStatus {
  MENUNGGU_VERIFIKASI
  BERHASIL
  DITOLAK
}
